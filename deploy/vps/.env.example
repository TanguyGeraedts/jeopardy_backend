# Copy to /opt/jeopardy/.env on the VPS and fill in. Never commit the real file.

# Database password. Generate one: openssl rand -base64 32 | tr -d '/+=' | head -c 32
POSTGRES_PASSWORD=

# Clerk PRODUCTION instance (Clerk dashboard > Configure > API keys).
# Frontend API URL, e.g. https://clerk.geraedts.dev
CLERK_ISSUER=
# Secret key sk_live_... (the publishable pk_live_... is a GitHub variable of the frontend repo, baked into its image).
CLERK_SECRET_KEY=

# Public address of the site: Clerk's "azp" check and where the lobby sends players (<it>/play/{id}).
JEOPARDY_PUBLIC_URL=https://jeopardy.geraedts.dev

# Optional:
# JEOPARDY_TAG=latest                               image tag of both Jeopardy images
# LOBBY_PUBLIC_KEY=/opt/lobby/secrets/public.pem    the lobby's production public key on this server
