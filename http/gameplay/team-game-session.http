@baseUrl = http://localhost:8080
@lobbyUrl = http://localhost:3100
@quizId = 30000000-0000-0000-0000-000000000001
# Paste the lobby HOST's sessionToken here (from the "join" response in your browser's dev tools) before step 4.
@hostToken = PASTE_HOST_SESSION_TOKEN_HERE

### 0. Get a dev token (owner of the seed quizzes). Run this first.
POST {{baseUrl}}/api/public/mock-auth/token
Content-Type: application/json

{}

> {%
    client.global.set("token", response.body.access_token);
    client.test("got a token", function() {
        client.assert(response.status === 200);
    });
%}


### 1. Create a TEAM game session from the quiz (also creates the lobby; teamCount is required)
POST {{baseUrl}}/api/v1/game-sessions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quizId": "{{quizId}}",
  "mode": "TEAM",
  "teamCount": 2,
  "maxPlayers": 4
}

> {%
    client.global.set("teamSessionId", response.body.data.gameSessionId);
    client.test("created", function() {
        client.assert(response.status === 201);
    });
%}


### 2. Get the session: board was copied from the quiz, lobby code assigned
GET {{baseUrl}}/api/v1/game-sessions/{{teamSessionId}}
Authorization: Bearer {{token}}
Accept: application/json

> {%
    client.global.set("lobbyCode", response.body.data.lobbyCode);
    client.log("Join this lobby in your browser: " + client.global.get("lobbyCode") + "  (lobby: " + "http://localhost:3100" + ")");
    client.global.set("clueId", response.body.data.clues[0].id);
    client.test("TEAM game in LOBBY with a board and a lobby code", function() {
        client.assert(response.body.data.mode === "TEAM");
        client.assert(response.body.data.state === "LOBBY");
        client.assert(response.body.data.lobbyCode);
        client.assert(response.body.data.clues.length > 0);
        client.assert(response.body.data.clues[0].category);
    });
%}


### 3. MANUAL: join the lobby in your browser (no request to run here)
# 1. Open {{lobbyUrl}} and join the lobby with the code logged by step 2 (also: GET the session and read "lobbyCode").
# 2. The first player to join is the lobby host. Have the other players join too.
# 3. In the HOST's browser dev tools (F12 > Network), open that player's "join" request and copy "sessionToken" from its response.
# 4. Paste it into @hostToken at the top of this file, then run step 4.


### 4. Start the lobby as the host: returns the signed handoff token (valid 5 minutes)
POST {{lobbyUrl}}/api/v1/lobbies/{{lobbyCode}}/start
Authorization: Bearer {{hostToken}}

> {%
    client.global.set("handoffToken", response.body.token);
    client.test("lobby started, got a handoff token", function() {
        client.assert(response.status === 200);
        client.assert(response.body.token);
    });
%}


### 5. Hand the token to Jeopardy: players imported, game starts
POST {{baseUrl}}/api/v1/game-sessions/{{teamSessionId}}/handoff
Content-Type: application/json

{ "token": "{{handoffToken}}" }

> {%
    client.test("started, lobby players imported", function() {
        client.assert(response.status === 200);
        client.assert(response.body.data.state === "BOARD_SELECTION");
        client.assert(response.body.data.players.length >= 1);
    });
%}


### 6. Replaying the same handoff must be refused
POST {{baseUrl}}/api/v1/game-sessions/{{teamSessionId}}/handoff
Content-Type: application/json

{ "token": "{{handoffToken}}" }

> {%
    client.test("409 on replay", function() {
        client.assert(response.status === 409);
    });
%}


### 7. Get again: everyone who joined the lobby was imported and persisted
GET {{baseUrl}}/api/v1/game-sessions/{{teamSessionId}}
Authorization: Bearer {{token}}
Accept: application/json

> {%
    client.test("lobby players imported and persisted", function() {
        client.assert(response.body.data.players.length >= 1);
        client.assert(response.body.data.teams.length > 0);
    });
%}


### 8. Answer a clue: state is BOARD_SELECTION so no active clue is selected yet
POST {{baseUrl}}/api/v1/game-sessions/{{teamSessionId}}/answer
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "clueId": "{{clueId}}",
  "answer": "anything"
}

> {%
    client.test("rejected when no active clue selected", function() {
        client.assert(response.status === 404);
    });
%}


### ---------- Negative cases for create ----------

### 9. TEAM game without teamCount: 400
POST {{baseUrl}}/api/v1/game-sessions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quizId": "{{quizId}}",
  "mode": "TEAM"
}

> {%
    client.test("400, team game needs teamCount", function() {
        client.assert(response.status === 400);
    });
%}


### 10. teamCount below the minimum of 2: 400
POST {{baseUrl}}/api/v1/game-sessions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quizId": "{{quizId}}",
  "mode": "TEAM",
  "teamCount": 1
}

> {%
    client.test("400 for teamCount < 2", function() {
        client.assert(response.status === 400);
    });
%}