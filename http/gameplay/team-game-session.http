@baseUrl = http://localhost:8080
@quizId = 30000000-0000-0000-0000-000000000001

### 0. Get a dev token (owner of the seed quizzes). Run this first.
POST {{baseUrl}}/api/public/mock-auth/token
Content-Type: application/json

{}

> {%
    client.global.set("token", response.body.access_token);
    client.test("got a token", function() {
        client.assert(response.status === 200);
    });
%}


### 1. Create a TEAM game session from the quiz
POST {{baseUrl}}/api/v1/game-sessions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "quizId": "{{quizId}}",
  "mode": "TEAM"
}

> {%
    client.global.set("teamSessionId", response.body.data.gameSessionId);
    client.test("created", function() {
        client.assert(response.status === 201);
    });
%}


### 2. Get the session: board was copied from the quiz and persisted
GET {{baseUrl}}/api/v1/game-sessions/{{teamSessionId}}
Authorization: Bearer {{token}}
Accept: application/json

> {%
    client.global.set("clueId", response.body.data.clues[0].id);
    client.test("TEAM game in LOBBY with a board", function() {
        client.assert(response.body.data.mode === "TEAM");
        client.assert(response.body.data.state === "LOBBY");
        client.assert(response.body.data.clues.length > 0);
        client.assert(response.body.data.clues[0].category);
    });
%}


### 3. Join host onto Team 1
POST {{baseUrl}}/api/v1/game-sessions/{{teamSessionId}}/join
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "playerId": "c64bb9bf-1ccc-46cc-a82f-9643fee38013",
  "playerName": "Tanguy",
  "externalTeamId": "1",
  "teamName": "Team 1",
  "teamColour": "RED"
}

> {%
    client.global.set("team1Id", response.body.data.teamId);
    client.test("created onto Team 1", function() {
        client.assert(response.status === 201);
    });
%}


### 4. Join player2 onto the same Team 1
POST {{baseUrl}}/api/v1/game-sessions/{{teamSessionId}}/join
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "playerId": "188e376d-fb1a-428c-9739-8f5e24705424",
  "playerName": "player2",
  "externalTeamId": "1",
  "teamName": "Team 1",
  "teamColour": "RED"
}

> {%
    client.test("correlates onto the same domain team", function() {
        client.assert(response.body.data.teamId === client.global.get("team1Id"));
    });
%}


### 5. Re-join the host (page refresh): idempotent, 200 not 201
POST {{baseUrl}}/api/v1/game-sessions/{{teamSessionId}}/join
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "playerId": "c64bb9bf-1ccc-46cc-a82f-9643fee38013",
  "playerName": "Tanguy",
  "externalTeamId": "1",
  "teamName": "Team 1",
  "teamColour": "RED"
}

> {%
    client.test("idempotent re-join", function() {
        client.assert(response.status === 200);
        client.assert(response.body.data.alreadyJoined === true);
    });
%}


### 6. Join a team game without a team: rejected
POST {{baseUrl}}/api/v1/game-sessions/{{teamSessionId}}/join
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "playerId": "f67ba636-ce42-40cc-9f86-3fc26781f811",
  "playerName": "Player3",
  "externalTeamId": null,
  "teamName": null,
  "teamColour": null
}

> {%
    client.test("rejected with 409, team required", function() {
        client.assert(response.status === 409);
        client.assert(response.body.detail.includes("team game"));
    });
%}


### 7. Get again: 2 players, 1 team (proves joins were persisted)
GET {{baseUrl}}/api/v1/game-sessions/{{teamSessionId}}
Authorization: Bearer {{token}}
Accept: application/json

> {%
    client.test("2 players on 1 team", function() {
        client.assert(response.body.data.players.length === 2);
        client.assert(response.body.data.teams.length === 1);
        client.assert(response.body.data.teams[0].memberIds.length === 2);
    });
%}


### 8. Answer a clue: no startGame endpoint yet, so there is no active clue
POST {{baseUrl}}/api/v1/game-sessions/{{teamSessionId}}/answer
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "clueId": "{{clueId}}",
  "answer": "anything"
}

> {%
    client.test("rejected while still in LOBBY", function() {
        client.assert(response.status === 404);
    });
%}